package {%.Plural%}_repositories

import (
	"context"
	"errors"
	"fmt"
	"slices"
	"strings"
	"sync"
	"time"
	"uuid"

	{%.Plural%}_entities "{%.Module%}/internal/restful/{%.FolderPlural%}/entities"
	"{%.Module%}/internal/contracts"
)

type {%.PascalPlural%}Repository struct {
	mu   *sync.RWMutex
	data map[uuid.UUID]{%.Plural%}_entities.{%.Pascal%}
}

func New{%.PascalPlural%}Repository() {%.PascalPlural%}Repository {
	return {%.PascalPlural%}Repository{
		mu:   &sync.RWMutex{},
		data: map[uuid.UUID]{%.Plural%}_entities.{%.Pascal%}{},
	}
}

func (r {%.PascalPlural%}Repository) Save(ctx context.Context, input {%.Plural%}_entities.{%.Pascal%}) ({%.Plural%}_entities.{%.Pascal%}, error) {

	r.mu.Lock()
	defer r.mu.Unlock()

	r.data[input.ID] = input

	return input, nil
}

func (r {%.PascalPlural%}Repository) Exists(ctx context.Context, input {%.Plural%}_entities.{%.Pascal%}) (bool, error) {

	r.mu.RLock()
	defer r.mu.RUnlock()

	item, ok := r.data[input.ID]

	return ok && item.DeletedAt == nil, nil
}

func (r {%.PascalPlural%}Repository) GetByID(ctx context.Context, id *uuid.UUID) ({%.Plural%}_entities.{%.Pascal%}, error) {

	r.mu.RLock()
	defer r.mu.RUnlock()

	item, ok := r.data[*id]
	if !ok || item.DeletedAt != nil {
		return {%.Plural%}_entities.{%.Pascal%}{}, errors.New("{%.Singular%} not found")
	}

	return item, nil
}

func (r {%.PascalPlural%}Repository) List(ctx context.Context) ([]{%.Plural%}_entities.{%.Pascal%}, error) {

	r.mu.RLock()
	defer r.mu.RUnlock()

	output := make([]{%.Plural%}_entities.{%.Pascal%}, 0, len(r.data))
	for _, item := range r.data {
		if item.DeletedAt == nil {
			output = append(output, item)
		}
	}

	slices.SortFunc(output, func(a, b {%.Plural%}_entities.{%.Pascal%}) int {
		return b.CreatedAt.Compare(a.CreatedAt)
	})

	return output, nil
}

func (r {%.PascalPlural%}Repository) Query(ctx context.Context, input contracts.QueryInput) ([]{%.Plural%}_entities.{%.Pascal%}, error) {

	const (
		defaultLimit = 20
		maxLimit     = 100
		defaultOrder = "created_at"
	)

	queryColumns := map[string]bool{
		"id":         true,
		"updated_at": true,
		"created_at": true,
	}

	var (
		filterID   *uuid.UUID
		filterDate = map[string]time.Time{}
	)

	for key, value := range input.Filters {
		if !queryColumns[key] {
			return nil, fmt.Errorf("invalid filter: %s", key)
		}

		text := fmt.Sprint(value)

		if key == "id" {
			id, err := uuid.Parse(text)
			if err != nil {
				return nil, fmt.Errorf("invalid filter id: %w", err)
			}
			filterID = &id
			continue
		}

		date, err := time.Parse(time.RFC3339Nano, text)
		if err != nil {
			return nil, fmt.Errorf("invalid filter %s: %w", key, err)
		}
		filterDate[key] = date
	}

	orderBy := defaultOrder
	if input.OrderBy != "" {
		if !queryColumns[input.OrderBy] {
			return nil, fmt.Errorf("invalid order_by: %s", input.OrderBy)
		}
		orderBy = input.OrderBy
	}

	r.mu.RLock()
	defer r.mu.RUnlock()

	output := make([]{%.Plural%}_entities.{%.Pascal%}, 0)

	for _, item := range r.data {
		if item.DeletedAt != nil {
			continue
		}
		if filterID != nil && item.ID != *filterID {
			continue
		}
		if date, ok := filterDate["created_at"]; ok && !item.CreatedAt.Equal(date) {
			continue
		}
		if date, ok := filterDate["updated_at"]; ok && !item.UpdatedAt.Equal(date) {
			continue
		}

		output = append(output, item)
	}

	desc := !strings.EqualFold(input.Order, "asc")

	slices.SortFunc(output, func(a, b {%.Plural%}_entities.{%.Pascal%}) int {
		var result int
		switch orderBy {
		case "id":
			result = a.ID.Compare(b.ID)
		case "updated_at":
			result = a.UpdatedAt.Compare(b.UpdatedAt)
		default:
			result = a.CreatedAt.Compare(b.CreatedAt)
		}
		if desc {
			return -result
		}
		return result
	})

	limit := input.Limit
	if limit <= 0 {
		limit = defaultLimit
	}
	limit = min(limit, maxLimit)

	offset := min(max(input.Offset, 0), len(output))

	return output[offset:min(offset+limit, len(output))], nil
}

func (r {%.PascalPlural%}Repository) Update(ctx context.Context, id *uuid.UUID, input {%.Plural%}_entities.{%.Pascal%}) ({%.Plural%}_entities.{%.Pascal%}, error) {

	r.mu.Lock()
	defer r.mu.Unlock()

	item, ok := r.data[*id]
	if !ok || item.DeletedAt != nil {
		return {%.Plural%}_entities.{%.Pascal%}{}, errors.New("{%.Singular%} not found")
	}

	item.UpdatedAt = input.UpdatedAt
	r.data[*id] = item

	return item, nil
}

func (r {%.PascalPlural%}Repository) Delete(ctx context.Context, id *uuid.UUID) error {

	r.mu.Lock()
	defer r.mu.Unlock()

	item, ok := r.data[*id]
	if !ok || item.DeletedAt != nil {
		return errors.New("{%.Singular%} not found")
	}

	now := time.Now()
	item.DeletedAt = &now
	r.data[*id] = item

	return nil
}
