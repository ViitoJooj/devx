package {%.Plural%}_repositories

import (
	"context"
	"database/sql"
	"errors"
	"fmt"
	"strings"
	"time"
	"uuid"

	{%.Plural%}_entities "{%.Module%}/internal/restful/{%.FolderPlural%}/entities"
	"{%.Module%}/internal/contracts"
)

type {%.PascalPlural%}Repository struct {
	DB *sql.DB
}

func New{%.PascalPlural%}Repository(pgdb *sql.DB) {%.PascalPlural%}Repository {
	return {%.PascalPlural%}Repository{
		DB: pgdb,
	}
}

func (r {%.PascalPlural%}Repository) Save(ctx context.Context, input {%.Plural%}_entities.{%.Pascal%}) ({%.Plural%}_entities.{%.Pascal%}, error) {

	const query = `
		INSERT INTO {%.Plural%} (id, updated_at, created_at, deleted_at)
		VALUES ($1, $2, $3, $4)
	`

	_, err := r.DB.ExecContext(ctx, query, input.ID.String(), input.UpdatedAt, input.CreatedAt, input.DeletedAt)
	if err != nil {
		return {%.Plural%}_entities.{%.Pascal%}{}, err
	}

	return input, nil
}

func (r {%.PascalPlural%}Repository) Exists(ctx context.Context, input {%.Plural%}_entities.{%.Pascal%}) (bool, error) {

	const query = `
		SELECT EXISTS(
			SELECT 1 FROM {%.Plural%}
			WHERE id = $1 AND deleted_at IS NULL
		)
	`

	var exists bool

	err := r.DB.QueryRowContext(ctx, query, input.ID.String()).Scan(&exists)
	if err != nil {
		return false, err
	}

	return exists, nil
}

func (r {%.PascalPlural%}Repository) GetByID(ctx context.Context, id *uuid.UUID) ({%.Plural%}_entities.{%.Pascal%}, error) {

	const query = `
		SELECT updated_at, created_at, deleted_at
		FROM {%.Plural%}
		WHERE id = $1 AND deleted_at IS NULL
	`

	output := {%.Plural%}_entities.{%.Pascal%}{ID: *id}

	err := r.DB.QueryRowContext(ctx, query, id.String()).Scan(&output.UpdatedAt, &output.CreatedAt, &output.DeletedAt)
	if errors.Is(err, sql.ErrNoRows) {
		return {%.Plural%}_entities.{%.Pascal%}{}, errors.New("{%.Singular%} not found")
	}
	if err != nil {
		return {%.Plural%}_entities.{%.Pascal%}{}, err
	}

	return output, nil
}

func (r {%.PascalPlural%}Repository) List(ctx context.Context) ([]{%.Plural%}_entities.{%.Pascal%}, error) {

	const query = `
		SELECT id, updated_at, created_at, deleted_at
		FROM {%.Plural%}
		WHERE deleted_at IS NULL
		ORDER BY created_at DESC
	`

	rows, err := r.DB.QueryContext(ctx, query)
	if err != nil {
		return nil, err
	}
	defer rows.Close()

	output := make([]{%.Plural%}_entities.{%.Pascal%}, 0)

	for rows.Next() {
		var (
			idStr string
			item  {%.Plural%}_entities.{%.Pascal%}
		)

		if err := rows.Scan(&idStr, &item.UpdatedAt, &item.CreatedAt, &item.DeletedAt); err != nil {
			return nil, err
		}

		item.ID, err = uuid.Parse(idStr)
		if err != nil {
			return nil, err
		}

		output = append(output, item)
	}

	if err := rows.Err(); err != nil {
		return nil, err
	}

	return output, nil
}

func (r {%.PascalPlural%}Repository) Query(ctx context.Context, input contracts.QueryInput) ([]{%.Plural%}_entities.{%.Pascal%}, error) {

	const (
		defaultLimit = 20
		maxLimit     = 100
		defaultOrder = "created_at"
	)

	queryColumns := map[string]bool{
		"id":         true,
		"updated_at": true,
		"created_at": true,
	}

	where := []string{"deleted_at IS NULL"}
	var args []any

	for key, value := range input.Filters {
		if !queryColumns[key] {
			return nil, fmt.Errorf("invalid filter: %s", key)
		}

		args = append(args, value)
		where = append(where, fmt.Sprintf("%s = $%d", key, len(args)))
	}

	orderBy := defaultOrder
	if input.OrderBy != "" {
		if !queryColumns[input.OrderBy] {
			return nil, fmt.Errorf("invalid order_by: %s", input.OrderBy)
		}
		orderBy = input.OrderBy
	}

	order := "DESC"
	if strings.EqualFold(input.Order, "asc") {
		order = "ASC"
	}

	limit := input.Limit
	if limit <= 0 {
		limit = defaultLimit
	}
	limit = min(limit, maxLimit)

	offset := max(input.Offset, 0)

	args = append(args, limit, offset)

	query := fmt.Sprintf(`
		SELECT id, updated_at, created_at, deleted_at
		FROM {%.Plural%}
		WHERE %s
		ORDER BY %s %s
		LIMIT $%d OFFSET $%d
	`, strings.Join(where, " AND "), orderBy, order, len(args)-1, len(args))

	rows, err := r.DB.QueryContext(ctx, query, args...)
	if err != nil {
		return nil, err
	}
	defer rows.Close()

	output := make([]{%.Plural%}_entities.{%.Pascal%}, 0)

	for rows.Next() {
		var (
			idStr string
			item  {%.Plural%}_entities.{%.Pascal%}
		)

		if err := rows.Scan(&idStr, &item.UpdatedAt, &item.CreatedAt, &item.DeletedAt); err != nil {
			return nil, err
		}

		item.ID, err = uuid.Parse(idStr)
		if err != nil {
			return nil, err
		}

		output = append(output, item)
	}

	if err := rows.Err(); err != nil {
		return nil, err
	}

	return output, nil
}

func (r {%.PascalPlural%}Repository) Update(ctx context.Context, id *uuid.UUID, input {%.Plural%}_entities.{%.Pascal%}) ({%.Plural%}_entities.{%.Pascal%}, error) {

	const query = `
		UPDATE {%.Plural%}
		SET updated_at = $2
		WHERE id = $1 AND deleted_at IS NULL
		RETURNING updated_at, created_at, deleted_at
	`

	output := {%.Plural%}_entities.{%.Pascal%}{ID: *id}

	err := r.DB.QueryRowContext(ctx, query, id.String(), input.UpdatedAt).Scan(&output.UpdatedAt, &output.CreatedAt, &output.DeletedAt)
	if errors.Is(err, sql.ErrNoRows) {
		return {%.Plural%}_entities.{%.Pascal%}{}, errors.New("{%.Singular%} not found")
	}
	if err != nil {
		return {%.Plural%}_entities.{%.Pascal%}{}, err
	}

	return output, nil
}

func (r {%.PascalPlural%}Repository) Delete(ctx context.Context, id *uuid.UUID) error {

	const query = `
		UPDATE {%.Plural%}
		SET deleted_at = $2
		WHERE id = $1 AND deleted_at IS NULL
	`

	result, err := r.DB.ExecContext(ctx, query, id.String(), time.Now())
	if err != nil {
		return err
	}

	affected, err := result.RowsAffected()
	if err != nil {
		return err
	}

	if affected == 0 {
		return errors.New("{%.Singular%} not found")
	}

	return nil
}
