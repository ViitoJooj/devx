package cmd

import (
	"context"
	"fmt"
	"os"
	"os/signal"

	"{%.Module%}/internal/resources"
	"{%.Module%}/internal/tools"
	"github.com/modelcontextprotocol/go-sdk/mcp"
)

// Execute starts the mcp server over stdio and blocks until the client disconnects.
func Execute() {

	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt)
	defer stop()

	server := mcp.NewServer(&mcp.Implementation{Name: "{%.Name%}", Version: "v0.0.1"}, nil)

	tools.Register(server)
	resources.Register(server)

	if err := server.Run(ctx, &mcp.StdioTransport{}); err != nil {
		fmt.Fprintf(os.Stderr, "Oops. An error while running {%.Name%} mcp '%s'\n", err)
		os.Exit(1)
	}
}
