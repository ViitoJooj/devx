package server

import (
	"context"

	"{%.Module%}/docs/openapi"
	server_http_controllers "{%.Module%}/internal/restful/server/http_controllers"
	server_repositories "{%.Module%}/internal/restful/server/repositories"
	server_usecases "{%.Module%}/internal/restful/server/usecases"
	"github.com/gin-gonic/gin"
)

func Init(ctx context.Context, server *gin.Engine) error {

	serverRepository := server_repositories.NewServerRepository(openapi.Spec)

	err := server_http_controllers.RegisterServerControllers(server_http_controllers.RegisterServerControllersInput{
		Router:         &server.RouterGroup,
		PingUseCase:    server_usecases.NewPingUseCase(serverRepository),
		OpenAPIUseCase: server_usecases.NewOpenAPIUseCase(serverRepository),
		DocsUseCase:    server_usecases.NewDocsUseCase(serverRepository),
	})

	return err
}
