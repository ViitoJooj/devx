package main

import (
	"context"

	"{%.Module%}/internal/restful/server"
	"{%.Module%}/internal/config"
	"{%.Module%}/internal/shared/errorx"
	"{%.Module%}/internal/shared/httpx"
	"github.com/gin-gonic/gin"
)

func main() {

	ctx, cancel := context.WithCancel(context.Background())
	api := gin.Default()

	api.Use(httpx.ErrorHandler())

	defer cancel()

	cfg, err := config.New(ctx)
	if err != nil {
		errorx.Fatal(err)
	}

	if err := server.Init(ctx, api); err != nil {
		errorx.Fatal(err)
	}

	if err := api.Run(":" + cfg.Application.Port); err != nil {
		errorx.Fatal(err)
	}
}
