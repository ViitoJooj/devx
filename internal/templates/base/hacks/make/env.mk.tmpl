# Detect OS
ifeq ($(OS),Windows_NT)
    DETECTED_OS := Windows
else
    UNAME_S := $(shell uname -s)
    ifeq ($(UNAME_S),Linux)
        DETECTED_OS := Linux
    endif
    ifeq ($(UNAME_S),Darwin)
        DETECTED_OS := macOS
    endif
endif

# Verify container manager
HAS_PODMAN := $(shell command -v podman 2> /dev/null)
HAS_DOCKER_PLUGIN := $(shell docker compose version 2> /dev/null)
HAS_DOCKER_STANDALONE := $(shell command -v docker-compose 2> /dev/null)

ifneq ($(HAS_PODMAN),)
    CONTAINER_ENGINE := podman
    COMPOSE_CMD := podman compose
else ifneq ($(HAS_DOCKER_PLUGIN),)
    CONTAINER_ENGINE := docker
    COMPOSE_CMD := docker compose
else ifneq ($(HAS_DOCKER_STANDALONE),)
    CONTAINER_ENGINE := docker
    COMPOSE_CMD := docker-compose
else
    CONTAINER_ENGINE := none
    COMPOSE_CMD := @echo "Erro: Nenhum container engine (podman/docker) foi encontrado no PATH."; exit 1;
endif

COMPOSE := $(COMPOSE_CMD) -f infra/compose/docker-compose.yaml --env-file .env
